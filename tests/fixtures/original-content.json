  "structuredData": [
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Wat kost het reinigen van mijn ventilatiekanalen?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "€149,99. Daarvoor reinigen we al je ventilatiekanalen én ventielen. Je betaalt dus geen prijs per ventiel."
          }
        },
        {
          "@type": "Question",
          "name": "Komen jullie ook bij mij in de buurt?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "We werken in heel Nederland. Stuur je postcode via WhatsApp, dan plannen we samen een moment."
          }
        },
        {
          "@type": "Question",
          "name": "Waarom zou ik mijn ventilatie laten reinigen?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Een vuil systeem blaast stof, huisstofmijt, bacteriën en schimmels gewoon je huis in. Dat zorgt voor een ongezond binnenklimaat en is extra vervelend voor kinderen, ouderen en mensen met astma. Een schone ventilatiebox werkt bovendien stiller en zuiniger."
          }
        },
        {
          "@type": "Question",
          "name": "Hoe weet ik of het tijd is?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Muffe lucht, grijze of zwarte randen rond de ventielen, een luidruchtige ventilatiebox, of je weet niet meer wanneer het voor het laatst is gedaan? Dan is het tijd."
          }
        },
        {
          "@type": "Question",
          "name": "Wordt het een rommel in huis?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nee. We werken met professionele apparatuur: schoon, snel en zonder rommel."
          }
        },
        {
          "@type": "Question",
          "name": "Doen jullie ook de ventilatiebox en WTW-unit?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ja. We reinigen en onderhouden ventilatieboxen en WTW-units, en we leveren en monteren ook een nieuwe, energiezuinige ventilatiebox als je oude verouderd of defect is. Stuur een foto van je box via WhatsApp voor een prijs."
          }
        },
        {
          "@type": "Question",
          "name": "Hoe maak ik een afspraak?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Stuur een appje of bel naar 06 44 83 15 15. Vermeld je postcode en wat je wilt laten doen, dan plannen we samen een moment dat jou uitkomt."
          }
        }
      ]
    },
